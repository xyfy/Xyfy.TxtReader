{
  "name": "xyfy-txt-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:zip": "rm -f dist/xyfy-txt-reader-v$npm_package_version.zip && mkdir -p dist && zip -r dist/xyfy-txt-reader-v$npm_package_version.zip . -x 'dist/*' '.git/*' '.github/*' '.vscode/*' 'node_modules/*' 'tests/*' 'docs/*' 'scripts/*' 'web/*' 'eslint.config.js' 'package-lock.json' 'tag-release.sh' 'package.json' '.gitignore' 'icons/icon.svg' 'index.html' '*.DS_Store'",
    "build:webapp": "node scripts/build-webapp.mjs",
    "lint": "eslint .",
    "gen:icons": "node scripts/gen-icons.mjs",
    "test": "npm run test:paginator && npm run test:backup && npm run test:storage-sync && npm run test:keyboard && npm run test:site-parity && npm run test:settings-panel && npm run test:color && npm run test:settings-panel-api && npm run test:cloud-provider && npm run test:encoding && npm run test:chapters && npm run test:paginator-large && npm run test:boundary && npm run test:error-report && npm run test:samples && npm run test:onboarding && npm run test:stats && npm run test:conflict && npm run test:quota && npm run test:a11y && npm run test:import && npm run test:scene && npm run test:regression",
    "test:paginator": "node tests/paginator.test.mjs",
    "test:paginator-large": "node tests/paginator-large.test.mjs",
    "test:encoding": "node tests/encoding.test.mjs",
    "test:chapters": "node tests/chapter-parser.test.mjs",
    "test:boundary": "node tests/reader-view-state.test.mjs",
    "test:error-report": "node tests/error-report.test.mjs",
    "test:samples": "node tests/samples.test.mjs",
    "test:regression": "node tests/regression.test.mjs",
    "gen:samples": "node scripts/gen-test-samples.mjs",
    "test:backup": "node tests/backup.test.mjs",
    "test:storage-sync": "node tests/storage-sync.test.mjs",
    "test:keyboard": "node tests/keyboard-map.test.mjs",
    "test:cloud-provider": "node tests/cloud-provider.test.mjs",
    "test:site-parity": "node tests/site-parity.test.mjs",
    "test:settings-panel": "node tests/settings-panel.test.mjs",
    "test:color": "node tests/reader-color.test.mjs",
    "test:settings-panel-api": "node tests/reader-settings-panel.test.mjs",
    "test:onboarding": "node tests/onboarding.test.mjs",
    "test:stats": "node tests/reading-stats.test.mjs",
    "test:conflict": "node tests/sync-conflict.test.mjs",
    "test:quota": "node tests/sync-quota.test.mjs",
    "test:a11y": "node tests/a11y.test.mjs",
    "test:import": "node tests/import-queue.test.mjs",
    "test:scene": "node tests/scene-mode.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "sharp": "^0.35.5"
  }
}
